DATABASE_URL=postgresql://user:password@localhost:5432/weather_data
STATION_PASSKEY=your_station_passkey_here
LOG_LEVEL=INFO
STATION_LATITUDE=47.6062
STATION_LONGITUDE=-122.3321
# Optional: set your known Bortle class (1=best dark sky, 9=inner city) to skip API lookup
# STATION_BORTLE_CLASS=2
# Optional: free API key from lightpollutionmap.info for precise sky brightness data
# STATION_LIGHTPOLL_KEY=your_key_here
